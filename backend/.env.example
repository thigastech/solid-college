# Copie para .env e ajuste. Não coloque credenciais reais em arquivos versionados.
FLASK_APP=run.py
APP_ENV=development
FLASK_DEBUG=1

# Caminho do SQLite. Padrão: backend/instance/catalogo.db
# DATABASE_URL=sqlite:///C:/caminho/absoluto/catalogo.db

# Origens do frontend autorizadas (separadas por vírgula)
CORS_ORIGINS=http://localhost:4200

# Proteção básica contra envio abusivo: N contatos por IP a cada janela (segundos)
CONTATO_RATE_LIMIT=5
CONTATO_RATE_WINDOW=600

# Tamanho máximo do corpo das requisições (bytes)
MAX_CONTENT_LENGTH=16384

# Pasta de destino do comando `flask backup-db`
# BACKUP_DIR=backups

LOG_LEVEL=INFO

# Captcha do formulário de contato (1 = ligado). Defina CAPTCHA_SEGREDO com um valor
# aleatório ao usar mais de um processo; vazio = cada processo gera o seu.
CAPTCHA_ATIVO=1
CAPTCHA_SEGREDO=
CAPTCHA_VALIDADE=1800

# Área administrativa (consulta de contatos em /admin).
# Gere um token longo e aleatório (mínimo 32 caracteres), por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Vazio = área administrativa desativada.
ADMIN_TOKEN=
ADMIN_FALHAS_LIMITE=10
ADMIN_FALHAS_JANELA=900
